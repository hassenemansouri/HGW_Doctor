#!/bin/sh /etc/rc.common
# HGW-Doctor procd init script
# Manages the hgw-doctor daemon under PrplOS/OpenWrt procd

USE_PROCD=1
START=95    # start after network (90) and bus daemon (80) are up
STOP=10

PROG=/usr/sbin/hgw-doctor
CONFIG=/etc/hgw_doctor/hgw_doctor.conf
PIDFILE=/var/run/hgw-doctor.pid

start_service() {
    mkdir -p /etc/amx/hgw_doctor/persist
    procd_open_instance hgw-doctor
    procd_set_param command "$PROG" "$CONFIG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$CONFIG"
    procd_set_param pidfile "$PIDFILE"
    procd_close_instance
}

reload_service() {
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null)
    [ -n "$pid" ] && kill -HUP "$pid" 2>/dev/null
}
