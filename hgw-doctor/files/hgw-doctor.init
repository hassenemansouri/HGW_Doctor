#!/bin/sh /etc/rc.common
# HGW-Doctor procd init script
# Manages the hgw-doctor daemon under PrplOS/OpenWrt procd

USE_PROCD=1
START=95    # start after network (90) and bus daemon (80) are up
STOP=10

ODL=/etc/amx/hgw_doctor/hgw_doctor.odl
PROG=/usr/sbin/hgw-doctor
CONFIG=/etc/hgw_doctor/hgw_doctor.conf

start_service() {
    # Instance 1: amxrt loads the ODL and registers the data model on ubus
    procd_open_instance "hgw-doctor-dm"
    procd_set_param command /usr/bin/amxrt /etc/amx/hgw_doctor/hgw_doctor.odl
    procd_set_param respawn 300 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    # Instance 2: standalone daemon handles monitoring and recovery
    procd_open_instance hgw-doctor
    procd_set_param command "$PROG" "$CONFIG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$CONFIG"
    procd_close_instance
}

reload_service() {
    # SIGHUP triggers config reload in the daemon
    kill -HUP "$(pidof hgw-doctor)" 2>/dev/null
}

stop_service() {
    kill -TERM "$(pidof hgw-doctor)" 2>/dev/null
}
