#!/bin/sh /etc/rc.common
# HGW-Doctor procd init script
# Manages the hgw-doctor daemon under PrplOS/OpenWrt procd

USE_PROCD=1
START=95    # start after network (90) and bus daemon (80) are up
STOP=10

PROG=/usr/sbin/hgw-doctor
CONFIG=/etc/hgw_doctor/hgw_doctor.conf
PIDFILE=/var/run/hgw-doctor.pid

start_service() {
    mkdir -p /etc/amx/hgw_doctor/persist

    # Ensure caps ODL exists (may be missing due to overlayfs)
    if [ ! -f /etc/amx/hgw_doctor/hgw_doctor_caps.odl ]; then
        cat > /etc/amx/hgw_doctor/hgw_doctor_caps.odl << 'CAPSEOF'
%config {
    ubus-path         = "HGWDoctor";
    register-name     = "hgw-doctor";
    event-throttle-ms = 1000;
    anomaly-log-max-entries = 50;
    diag-archive-max-files  = 10;
    upload-timeout-s     = 30;
    upload-max-retries   = 3;
    upload-retry-delay-s = 5;
    upload-tls-verify    = true;
    upload-ca-cert-path  = "/etc/ssl/certs/ca-certificates.crt";
}
CAPSEOF
        logger -t hgw-doctor "Created missing hgw_doctor_caps.odl"
    fi

    procd_open_instance hgw-doctor
    procd_set_param command "$PROG" "$CONFIG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$CONFIG"
    procd_set_param pidfile "$PIDFILE"
    procd_close_instance
}

reload_service() {
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null)
    [ -n "$pid" ] && kill -HUP "$pid" 2>/dev/null
}
