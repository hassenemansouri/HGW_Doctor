/**
 * hgw_doctor_caps.odl
 *
 * Runtime capabilities and bus-registration configuration for HGW-Doctor.
 *
 * This file is parsed after the main hgw_doctor.odl to:
 *  - Declare access-control rules (which bus users may read/write parameters)
 *  - Set ubus/PCB registration namespace
 *  - Tune Ambiorix runtime behaviour (event throttling, history depth, etc.)
 *
 * Included from hgw_doctor.odl via: #include "hgw_doctor_caps.odl";
 */
%config {

    /* -----------------------------------------------------------------------
     * Bus registration
     * The data model is registered as HGWDoctor on ubus/PCB.
     * ACS accesses it as Device.X_TELNET_HGWDoctor via the tr181-device
     * proxy mapping in 01_device-hgw_doctor_mapping.odl.
     * --------------------------------------------------------------------- */
    ubus-path    = "HGWDoctor";
    register-name = "hgw-doctor";

    /* -----------------------------------------------------------------------
     * Ambiorix event bus throttling
     * Limits how often "value-changed" events are emitted for fast-changing
     * read-only counters (Stats.*) to avoid flooding the bus.
     * Unit: milliseconds.
     * --------------------------------------------------------------------- */
    event-throttle-ms = 1000;

    /* -----------------------------------------------------------------------
     * AnomalyLog history cap
     * Maximum number of entries kept in the AnomalyLog multi-instance table.
     * Oldest entries are purged when the cap is reached.
     * --------------------------------------------------------------------- */
    anomaly-log-max-entries = 50;

    /* -----------------------------------------------------------------------
     * Diagnostics archive retention
     * Maximum number of .tar.gz archives kept in /tmp/hgw_diag/ before
     * the oldest is deleted on each new collection run.
     * --------------------------------------------------------------------- */
    diag-archive-max-files = 10;

    /* -----------------------------------------------------------------------
     * HTTPS upload settings
     * TLS and retry behaviour for the Uploader module.
     * --------------------------------------------------------------------- */
    upload-timeout-s     = 30;
    upload-max-retries   = 3;
    upload-retry-delay-s = 5;
    upload-tls-verify    = true;
    upload-ca-cert-path  = "/etc/ssl/certs/ca-certificates.crt";
}


