/**
 * hgw_doctor_persist.odl
 *
 * Persistent state file for HGW-Doctor.
 *
 * This file is AUTOMATICALLY GENERATED by the daemon at shutdown
 * (when odl-save-on-stop = true). Do NOT edit by hand during operation.
 *
 * It is read back at startup AFTER hgw_doctor_defaults.odl so that
 * operator-configured values (thresholds, ActionType, UploadURL, etc.)
 * survive reboots.
 *
 * Location: /etc/amx/hgw_doctor/hgw_doctor_persist.odl
 * Permissions: 600 (written by hgw-doctor process only)
 *
 * Structure mirrors %populate blocks from hgw_doctor_defaults.odl.
 * Only parameters marked persistent (i.e., not %read-only) are saved.
 */

%populate {

    object HGWDoctor {

        /* Operator-configured values (written by ACS or CLI) */
        parameter Enable             = true;
        parameter Profile            = "default";
        parameter CPUThreshold       = 90;
        parameter MemThreshold       = 90;
        parameter ThresholdDuration  = 60;
        parameter PollInterval       = 5;
        parameter ActionType         = "ProcessRestart";
        parameter ProcessList        = "";
        parameter UploadURL          = "https://diagnostics.telnet.tn/upload";

        /* Operator-defined custom profiles are persisted here as well */
        /* (Built-in profiles are always re-created from defaults.odl)  */
    }
}
