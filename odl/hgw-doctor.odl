/**
 * hgw-doctor.odl
 *
 * amxrt loader ODL for the HGW-Doctor plugin.
 *
 * Usage:
 *   amxrt odl/hgw-doctor.odl
 *
 * This file:
 *   1. Configures the Ambiorix runtime (save path, resolver order).
 *   2. Imports the shared library that contains the C callbacks.
 *   3. Includes the data model schema (GatewayHealth object).
 *   4. Declares the plugin entry point called by amxrt on start/stop.
 */

%config {
    name                = "hgw-doctor";
    import-dbg          = false;
    auto-resolver-order = [ "ftab", "auto" ];

    /* Persistent parameter values are saved here on stop and restored on start */
    odl-save-path    = "/etc/amx/hgw-doctor/";
    odl-save-on-stop = true;
}

/* Load the shared library containing all C callback implementations */
import "hgw_doctor.so" as "hgw_doctor";

/* Data model object definitions */
#include "hgw-doctor_definition.odl";

/* Declare the plugin entry point:
 *   amxrt calls _hgwdoctor_main(0, dm, parser) on start
 *              _hgwdoctor_main(1, dm, parser) on stop
 */
%populate {
    entry-point "hgw_doctor:_hgwdoctor_main";
}
