/*
 * hgw_doctor.odl
 *
 * TR-181 data model for HGW-Doctor: HGWDoctor (ubus).
 * Parsed by libamxo at startup; registered on ubus via the Ambiorix bus backend.
 *
 * Write callbacks are NOT declared here — they are registered programmatically
 * via amxd_param_add_action_cb() after ODL parse to avoid libamxd 6.9.x
 * re-entrancy crashes that occur when callbacks fire during parse-time
 * default value initialisation.
 */

%config {
    name = "hgw-doctor";
    import-dbg = false;
    auto-resolver-order = [ "ftab", "auto" ];

    /* persistent state is saved here on daemon stop — separate from installed ODL files */
    odl-save-path    = "/etc/amx/hgw_doctor/persist/";
    odl-save-on-stop = true;
}

import "hgw_doctor.so" as "hgw_doctor";

%define {

    object HGWDoctor {

        /* Global control */
        %persistent bool Enable = true;
        %read-only string Status = "Disabled";   /* "Enabled" | "Disabled" | "Error" */
        %persistent string Profile = "default";

        /* Monitoring thresholds */
        %persistent uint32 CPUThreshold = 90;        /* % above which anomaly is declared */
        %persistent uint32 MemThreshold = 90;
        %persistent uint32 ThresholdDuration = 60;   /* consecutive seconds threshold must hold */
        %persistent uint32 PollInterval = 5;         /* seconds between metric samples */

        /* Recovery */
        /* ActionType: "ProcessRestart" | "CacheClear" | "Reboot" | "None"
         * Writing a non-None value triggers an immediate on-demand action
         * and resets ActionType back to "None" automatically. */
        %persistent string ActionType = "None";
        %persistent string ProcessList = "";
        %persistent string OnDemandTarget = "";  /* specific target for on-demand ProcessRestart */
        %persistent uint32 RebootDelaySec = 10;
        %persistent %read-only uint32 RebootCount = 0;
        %persistent %read-only string LastRebootTime = "";

        /* Recovery status (RO, updated after each action) */
        %read-only string LastActionType = "";
        %read-only datetime LastActionTime = "0001-01-01T00:00:00Z";
        %read-only string LastActionStatus = "None";
        %persistent %read-only uint32 AnomalyCount = 0;

        /* Diagnostics & upload */
        bool OnDemandTrigger = false;
        %persistent string DiagOutputDir = "/tmp/hgw_diag";
        %read-only string DiagArchivePath = "";
        %persistent string UploadURL = "";
        %read-only string UploadStatus = "None";
        %read-only datetime UploadTimestamp = "0001-01-01T00:00:00Z";

        /* Live statistics (RO) */
        object Stats {
            %read-only uint32 CurrentCPUUsage = 0;
            %read-only uint32 CurrentMemUsage = 0;
            %read-only uint32 CurrentMemFreeKB = 0;
            %persistent %read-only uint32 TotalRecoveryActions = 0;
            %persistent %read-only uint32 TotalDiagUploads = 0;
            %read-only uint32 UptimeSeconds = 0;
        }
        object SelfStats {
            %read-only uint32 CurrentCPUUsage = 0;
            %read-only uint32 CurrentMemUsage = 0;
            %read-only uint32 CurrentRSSKB = 0;
        }

        /* Monitoring profiles — path: HGWDoctor.Profiles.{i}. */
        object Profiles[] {
            %persistent %key string Name;
            %persistent uint32 CPUThreshold = 90;
            %persistent uint32 MemThreshold = 90;
            %persistent uint32 ThresholdDuration = 60;
            %persistent string ActionType = "ProcessRestart";
            %persistent uint32 PollInterval = 5;
            %persistent string ProcessList = "";
            %persistent string Description = "";
        }

        /* Anomaly event log — path: HGWDoctor.AnomalyLog.{i}. */
        object AnomalyLog[] {
            %read-only datetime Timestamp;
            %read-only string AnomalyType = "";   /* "CPU" | "Memory" | "Process" */
            %read-only uint32 MetricValue = 0;
            %read-only string ProcessName = "";
            %read-only string ActionTaken = "";
            %read-only string ActionResult = "";
        }

        /* RPC methods */
        uint32 TriggerDiagnostics() <!import:hgw_doctor:dm_trigger_diagnostics!>;
        void ResetCounters() <!import:hgw_doctor:dm_reset_counters!>;
        int32 SetProfile(%in string ProfileName) <!import:hgw_doctor:dm_set_profile!>;
    }
}

#include "hgw_doctor_caps.odl";
#include "hgw_doctor_defaults.odl";
